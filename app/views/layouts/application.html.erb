<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title><%= content_for(:title) || "Tracer" %></title>
    <%= stylesheet_link_tag "application" %>
  </head>
  <body>
    <div class="shell">
      <aside class="side">
        <div class="brand"><span class="dot"></span> Tracer</div>
        <nav>
          <%= link_to "To-Do", root_path, class: "nav #{current_page?(root_path) ? 'active' : ''}" %>
          <%= link_to "Entregas do dia", entregas_path, class: "nav #{current_page?(entregas_path) ? 'active' : ''}" %>
          <%= link_to "1-on-1", one_on_ones_path, class: "nav #{current_page?(one_on_ones_path) ? 'active' : ''}" %>
          <%= link_to "Configurações", settings_path, class: "nav #{current_page?(settings_path) ? 'active' : ''}" %>
        </nav>
        <div class="version muted">v0.0.1 · POC</div>
      </aside>
      <div class="wrap">
        <%= yield %>
      </div>
    </div>
  </body>
</html>
