#!/usr/bin/env ruby
require "fileutils"

APP_ROOT = File.expand_path("..", __dir__)

def system!(*args)
  system(*args, exception: true)
end

FileUtils.chdir APP_ROOT do
  # Setup do Tracker (spec §4): gems + banco + seeds + notificação de teste.
  # Idempotente — pode rodar a qualquer momento.

  puts "== Installing dependencies =="
  system("bundle check") || system!("bundle install")

  puts "\n== Preparing database =="
  system! "bin/rails db:prepare"
  system! "bin/rails db:reset" if ARGV.include?("--reset")

  puts "\n== Loading seeds (tarefas de exemplo) =="
  system! "bin/rails db:seed"

  puts "\n== Removing old logs and tempfiles =="
  system! "bin/rails log:clear tmp:clear"

  puts "\n== Testing native notifications =="
  puts "(na primeira execução no macOS/Windows, conceda a permissão quando o S.O. perguntar)"
  system! "bin/rails runner 'Tracker::NativeNotifier.test!'"

  puts "\n✓ Setup completo! Rode ./bin/start para iniciar o Tracker."
end
