#!/usr/bin/env ruby
require "fileutils"

APP_ROOT = File.expand_path("..", __dir__)

def system!(*args)
  system(*args, exception: true)
end

FileUtils.chdir APP_ROOT do
  # Setup do Tracker (spec §4 + ADR 0001): gems + schema do Notion + notificação
  # de teste. Idempotente — pode rodar a qualquer momento. O Database "To-Dos"
  # é criado manualmente no Notion (ver README); o schema é validado no boot.

  puts "== Installing dependencies =="
  system("bundle check") || system!("bundle install")

  puts "\n== Removing old logs and tempfiles =="
  system! "bin/rails log:clear tmp:clear"

  puts "\n== Testing native notifications =="
  puts "(na primeira execução no macOS/Windows, conceda a permissão quando o S.O. perguntar)"
  system! "bin/rails runner 'Tracker::NativeNotifier.test!'"

  puts "\n== Validando schema do Database no Notion (pula se sem token) =="
  if ENV["TRACER_NOTION_TOKEN"]
    system! "./bin/rails runner 'Tracker::Notion::SchemaValidator.new(client: Tracker::Notion::Client.from_env, expected: Todos::Repositories::NotionSchema::PROPERTIES).validate!; puts \"schema OK\"'"
  else
    puts "(TRACER_NOTION_TOKEN não definido — validação acontece no primeiro boot)"
  end

  puts "\n✓ Setup completo! Rode ./bin/start para iniciar o Tracker."
end
